# Groq
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=12000

# Groq limits (copy from console.groq.com/settings/limits)
GROQ_RPM=30
GROQ_TPM=15000
GROQ_RPD=14400
GROQ_TPD=500000
LIMIT_SAFETY_FACTOR=0.8

# Per-user limits
USER_LIMIT_PER_MIN=5
USER_LIMIT_PER_DAY=30

# Upstash Redis (Optional for production distributed counters)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional bot check
TURNSTILE_SECRET_KEY=

# Images
MAX_IMAGE_MB=1.5
MAX_IMAGE_EDGE_PX=1024
CACHE_TTL_SECONDS=600
